# Local demo credentials. Do not point these at a real hospital system.
HOICO_ROOT=.
HOICO_SEED=42
HOICO_TIMEZONE=America/Chicago

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hoico
POSTGRES_USER=hoico
POSTGRES_PASSWORD=hoico
HOICO_DATABASE_URL=postgresql+psycopg://hoico:hoico@localhost:5432/hoico

MLFLOW_TRACKING_URI=file:./mlruns

# snapshot (default, used by Vercel) or live (Next.js calls FastAPI)
HOICO_DATA_MODE=snapshot
HOICO_API_URL=http://localhost:8000
HOICO_SNAPSHOT_PATH=

# Airflow metadata on the same Postgres instance, separate database.
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://hoico:hoico@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=nd8ho4CseukGm0kwMjZUOeUNx13ODpC-SBD4vhDEZBA=
AIRFLOW__WEBSERVER__SECRET_KEY=hoico-local-demo-secret
AIRFLOW_WWW_USER_USERNAME=airflow
AIRFLOW_WWW_USER_PASSWORD=airflow

# Databricks Free Edition. Leave blank until you sign in. No commercial trial.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
